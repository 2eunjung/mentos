<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="nomtrio.mentos.user.UserDao">

    <insert id="register" parameterType="nomtrio.mentos.user.UserVO">
        INSERT INTO MEMBERS
        (MEMBER_NM
        ,MEMBER_NICK
        ,MEMBER_PW
        ,MEMBER_BIRTH
        ,MEMBER_TEL
        ,MEMBER_EMAIL
        ,MEMBER_ZIP
        ,MEMBER_ADDR1
        ,MEMBER_ADDR2
        ,MEMBER_AUTH
        ,MENTOR_EXPERTISE
        ,MENTOR_EXPERIENCE
        ,MENTOR_CURRENT_JOB)
        VALUES
        (#{member_nm}
        ,#{member_nick}
        ,#{member_pw}
        ,#{member_birth}
        ,#{member_tel}
        ,#{member_email}
        ,#{member_zip}
        ,#{member_addr1}
        ,#{member_addr2}
        ,#{member_auth}
        ,#{mentor_expertise}
        ,#{mentor_experience}
        ,#{mentor_current_job})
    </insert>

    <select id="findByUsername" parameterType="String" resultType="nomtrio.mentos.user.UserVO">
        SELECT *
        FROM MEMBERS
        WHERE 1=1
        AND MEMBER_NICK = #{username}
    </select>

</mapper>
